# Copy this file to .env and fill in your real key. Never commit the real .env file.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used for tool-selection and for draft_email generation.
# Left configurable (instead of hardcoded in source) so this project keeps working
# if/when Anthropic ships a newer model, without needing a code change.
CLAUDE_MODEL=claude-sonnet-4-6
